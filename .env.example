# ─────────────────────────────────────────────────────────────────────
# Backend (FastAPI) — copy to `.env` in the repository root.
# ─────────────────────────────────────────────────────────────────────
# Shared secret used by the Next.js server to sign short-lived JWTs for the API.
# Generate with: openssl rand -base64 48   (must be identical in frontend/.env.local)
BACKEND_JWT_SECRET=

# Google AI Studio key (Gemini generation + embeddings)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# EMBED_MODEL=gemini-embedding-001
# EMBED_DIMS=768

# Optional overrides
# ENVIRONMENT=development           # development | production
# DATABASE_URL=sqlite:///backend/data/blindcreators.sqlite   # or postgresql+psycopg://...
# CORS_ORIGINS=["http://localhost:3000"]
# MIN_VIEWS_FOR_RETENTION=1000      # below this a retention curve is flagged as noisy
# RETENTION_REFRESH_DAYS=7
# MAX_VIDEOS=500
# TRANSCRIPTS_ENABLED=true
# AI_REQUESTS_PER_WINDOW=30
# ENABLE_DEBUG_ROUTES=false
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────────────
# Frontend (Next.js) — put these in `frontend/.env.local`.
# ─────────────────────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NEXTAUTH_SECRET=            # openssl rand -base64 32
# NEXTAUTH_URL=http://localhost:3000
# BACKEND_JWT_SECRET=         # same value as above
# BACKEND_URL=http://127.0.0.1:8000
